{
  "project": {
    "name": "SMIT Chat - Unified Messaging Platform",
    "type": "Vue 3 SPA",
    "stage": "MVP Phase - Active Development",
    "analyzedDate": "2026-01-27"
  },
  
  "techStack": {
    "framework": {
      "name": "Vue",
      "version": "3.5.24"
    },
    "build": {
      "name": "Vite",
      "version": "7.2.4"
    },
    "language": {
      "name": "TypeScript",
      "version": "5.9.3",
      "strictMode": true
    },
    "styling": {
      "name": "Tailwind CSS",
      "version": "4.1.18"
    },
    "stateManagement": {
      "name": "Pinia",
      "version": "3.0.3"
    },
    "testing": {
      "unit": "Vitest 4.0.16 + Vue Test Utils 2.4.6",
      "e2e": "Playwright 1.58.0"
    }
  },

  "buildConfiguration": {
    "vite": {
      "port": 8309,
      "https": {
        "enabled": true,
        "type": "self-signed certificate (auto-generated)"
      },
      "host": "0.0.0.0",
      "apiProxy": {
        "pattern": "/api/*",
        "target": "https://cuts-desktops-dishes-abstract.trycloudflare.com"
      },
      "pathAlias": "@/*:src/*",
      "plugins": [
        "@vitejs/plugin-vue",
        "@tailwindcss/vite",
        "@vitejs/plugin-basic-ssl"
      ]
    },
    "typescript": {
      "app": "tsconfig.app.json",
      "node": "tsconfig.node.json",
      "settings": {
        "target": "ES2020+",
        "module": "ESNext",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "moduleResolution": "ESNext",
        "skipLibCheck": true
      }
    }
  },

  "testing": {
    "unit": {
      "framework": "Vitest",
      "version": "4.0.16",
      "environment": "happy-dom",
      "setupFile": "src/__tests__/setup.ts",
      "filePattern": "**/*.{test,spec}.{js,ts,vue}",
      "coverage": {
        "provider": "v8",
        "reporters": ["text", "json", "html"],
        "excluded": ["node_modules/", "src/__tests__/", "**/*.d.ts", "**/*.config.*", "**/index.ts"]
      },
      "testFiles": {
        "components": 19,
        "controllers": 1,
        "store": 1,
        "composables": 1,
        "common": 1,
        "total": 23
      },
      "scripts": {
        "test": "vitest (watch mode)",
        "test:run": "vitest run (single run - CI)",
        "test:coverage": "vitest run --coverage",
        "test:ui": "vitest --ui"
      }
    },
    "e2e": {
      "framework": "Playwright",
      "version": "1.58.0",
      "configFile": "e2e/playwright.config.ts",
      "baseURL": "https://localhost:8309",
      "browsers": ["Chromium (Desktop Chrome)", "iPhone 14 (Mobile Safari)"],
      "features": {
        "parallelExecution": true,
        "retriesCI": 2,
        "retriesLocal": 0,
        "screenshots": "on-failure",
        "video": "on-failure",
        "tracing": "on-first-retry"
      },
      "autoStartServer": {
        "command": "npm run dev",
        "timeout": 120000,
        "reuseExisting": true
      },
      "status": "Configuration ready, no tests implemented yet",
      "scripts": {
        "test:e2e": "playwright test --config=e2e/playwright.config.ts",
        "test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
        "test:e2e:headed": "playwright test --config=e2e/playwright.config.ts --headed",
        "test:e2e:debug": "playwright test --config=e2e/playwright.config.ts --debug"
      }
    },
    "globals": {
      "mocks": [
        "localStorage (full in-memory implementation)",
        "navigator.clipboard (writeText, readText)",
        "image() function (mock path resolution)",
        "vue-sonner (toast notifications)",
        "import.meta.env (DEV, PROD, MODE)"
      ],
      "cleanupStrategy": {
        "beforeAll": "Setup mocks",
        "afterEach": "Clear mocks & localStorage",
        "afterAll": "Restore all mocks"
      }
    }
  },

  "dependencies": {
    "runtime": {
