        "tailwind-merge@3.4.0",
        "tw-animate-css@1.4.0"
      ]
    }
  },

  "codeQuality": {
    "eslint": {
      "format": "Flat config (ESLint v9+)",
      "configFile": "eslint.config.ts",
      "rules": [
        {
          "rule": "@typescript-eslint/no-unused-vars",
