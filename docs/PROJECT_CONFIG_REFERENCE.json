        },
        {
          "rule": "vue/no-unused-components",
          "level": "warn"
        }
      ],
      "notes": "All rules are warnings (development-friendly), commented error rules available if stricter enforcement needed"
    },
    "typeChecking": {
      "enabled": true,
      "runAtBuild": true,
      "command": "vue-tsc -b && vite build"
    },
    "namingConventions": {
      "variables": "snake_case",
      "functions": "camelCase",
      "classes": "PascalCase",
      "constants": "SCREAMING_SNAKE_CASE"
    }
