        "@types/node": "^24.10.3",
        "@types/pixelmatch": "^5.2.6",
        "@types/pngjs": "^6.0.5",
        "@types/randomstring": "^1.3.0",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.8.1",
        "happy-dom": "^20.0.11",
        "lucide-vue-next": "^0.511.0",
        "pixelmatch": "^7.1.0",
