# Phase 3: State Management & Interactions

## Overview
Logic xử lý các state transitions và user interactions cho ImageGalleryPopup.

## State Machine

```
┌─────────────────────────────────────────────────────────────┐
│                     GALLERY STATES                          │
├─────────────────────────────────────────────────────────────┤
│                                                             │
│  ┌──────────────┐    search empty    ┌──────────────────┐   │
│  │  folder_list │ ────────────────▶  │   search_empty   │   │
│  │   (default)  │ ◀────────────────  │                  │   │
│  └──────────────┘    clear search    └──────────────────┘   │
│         │                                                   │
│         │ select empty folder                               │
│         ▼                                                   │
│  ┌──────────────┐                                           │
│  │ empty_folder │                                           │
│  └──────────────┘                                           │
│         │                                                   │
│         │ add image / select folder with images             │
│         ▼                                                   │
│  ┌──────────────┐    expand image    ┌──────────────────┐   │
│  │  folder_list │ ────────────────▶  │   image_detail   │   │
│  └──────────────┘ ◀────────────────  │                  │   │
│                      close detail    └──────────────────┘   │
│                                                             │
└─────────────────────────────────────────────────────────────┘
```

## Core Functions

### Folder Management

```typescript
// Select folder
const selectFolder = (folder_id: string) => {
    selected_folder_id.value = folder_id
    // Clear image selection when switching folders
    selected_image_ids.value.clear()

    // Update view based on folder content
    if (current_folder_images.value.length === 0) {
        current_view.value = "empty_folder"
    } else {
        current_view.value = "folder_list"
    }
}

// Add new folder
const addFolder = async () => {
    const new_folder: GalleryFolder = {
        id: generateId(),
        name: "Folder mới",
        image_count: 0,
        is_editable: true,
        created_at: new Date().toISOString()
    }
    folders.value.push(new_folder)
    selectFolder(new_folder.id)
}

// Search folders
const filtered_folders = computed(() => {
    if (!folder_search.value) return folders.value

    const search = folder_search.value.toLowerCase()
    return folders.value.filter(f =>
        f.name.toLowerCase().includes(search)
    )
})
```

### Image Selection

```typescript
// Toggle single image
const toggleImageSelection = (image_id: string) => {
    if (selected_image_ids.value.has(image_id)) {
        selected_image_ids.value.delete(image_id)
    } else {
        // Check max selection limit
        if (props.maxSelection && selected_image_ids.value.size >= props.maxSelection) {
            return // Don't add more
        }
        selected_image_ids.value.add(image_id)
    }
}

// Select all images in current folder
const selectAllImages = () => {
    current_folder_images.value.forEach(img => {
        if (props.maxSelection && selected_image_ids.value.size >= props.maxSelection) {
            return
        }
        selected_image_ids.value.add(img.id)
    })
}

// Deselect all
const deselectAllImages = () => {
    selected_image_ids.value.clear()
}
```

### Image Actions

```typescript
// Save image (download)
const saveImage = (image: GalleryImage) => {
    const link = document.createElement("a")
    link.href = image.url
    link.download = image.name
    link.click()
}

// Zoom image (in popup)
const zoomImage = (image: GalleryImage) => {
    // Could show a mini zoom overlay
    // Or open detail view with zoom
    expandImage(image)
}

// Expand to full view
const expandImage = (image: GalleryImage) => {
    detail_image.value = image
    detail_zoom_level.value = 1
    current_view.value = "image_detail"
}

// Close detail view
const closeDetailView = () => {
    detail_image.value = null
    detail_zoom_level.value = 1
    current_view.value = "folder_list"
}
```

### Image Name Editing

```typescript
// Start editing
const startEditImageName = (image_id: string) => {
    is_editing_image_name.value = true
    editing_image_id.value = image_id
}

// Save name
const saveImageName = (image_id: string, new_name: string) => {
    const image = images.value.find(img => img.id === image_id)
    if (image) {
        image.name = new_name
    }
    is_editing_image_name.value = false
    editing_image_id.value = null
}

// Cancel editing
const cancelEditImageName = () => {
    is_editing_image_name.value = false
    editing_image_id.value = null
}
```

### Move Images

```typescript
// Open move dialog
const openMoveDialog = () => {
    if (selected_image_ids.value.size === 0) return

    move_dialog.value = {
        is_open: true,
        image_ids: [...selected_image_ids.value],
        target_folder_id: null
    }
}

// Close move dialog
const closeMoveDialog = () => {
    move_dialog.value = {
        is_open: false,
        image_ids: [],
        target_folder_id: null
    }
}

// Confirm move
const confirmMove = () => {
    if (!move_dialog.value.target_folder_id) return

    const target_id = move_dialog.value.target_folder_id

    // Update image folder_ids
    move_dialog.value.image_ids.forEach(img_id => {
        const image = images.value.find(img => img.id === img_id)
        if (image) {
            // Update folder counts
            const old_folder = folders.value.find(f => f.id === image.folder_id)
            const new_folder = folders.value.find(f => f.id === target_id)

            if (old_folder) old_folder.image_count--
            if (new_folder) new_folder.image_count++

            image.folder_id = target_id
        }
    })

    // Clear selection
    selected_image_ids.value.clear()
    closeMoveDialog()
}
```

### Delete Images

```typescript
// Delete single image
const deleteSingleImage = (image_id: string) => {
    delete_dialog.value = {
        is_open: true,
        image_ids: [image_id]
    }
}

// Delete selected images
const openDeleteDialog = () => {
    if (selected_image_ids.value.size === 0) return

    delete_dialog.value = {
        is_open: true,
        image_ids: [...selected_image_ids.value]
    }
}

// Confirm delete
const confirmDelete = () => {
    delete_dialog.value.image_ids.forEach(img_id => {
        const index = images.value.findIndex(img => img.id === img_id)
        if (index !== -1) {
            const image = images.value[index]
            // Update folder count
            const folder = folders.value.find(f => f.id === image.folder_id)
            if (folder) folder.image_count--

            images.value.splice(index, 1)
        }
    })

    // Clear selection
    selected_image_ids.value.clear()
    delete_dialog.value = { is_open: false, image_ids: [] }

    // Check if folder is now empty
    if (current_folder_images.value.length === 0) {
        current_view.value = "empty_folder"
    }
}
```

### Add Images

```typescript
// Open file picker
const openFilePicker = () => {
    const input = document.createElement("input")
    input.type = "file"
    input.accept = "image/*"
    input.multiple = true
    input.onchange = (e) => handleFilesSelected(e)
    input.click()
}

// Handle files selected
const handleFilesSelected = async (event: Event) => {
    const files = (event.target as HTMLInputElement).files
    if (!files || files.length === 0) return

    // Emit for parent to handle upload
    emit("add-images", Array.from(files))

    // Or handle locally
    for (const file of files) {
        const url = URL.createObjectURL(file)
        const new_image: GalleryImage = {
            id: generateId(),
            folder_id: selected_folder_id.value || folders.value[0].id,
            url: url,
            thumbnail_url: url,
            name: file.name,
            size: file.size,
            width: 0,
            height: 0,
            created_at: new Date().toISOString()
        }
        images.value.push(new_image)

        // Update folder count
        const folder = folders.value.find(f => f.id === new_image.folder_id)
        if (folder) folder.image_count++
    }

    current_view.value = "folder_list"
}
```

### Confirm Selection

```typescript
// Confirm and emit selected images
const confirmSelection = () => {
    const selected = images.value.filter(img =>
        selected_image_ids.value.has(img.id)
    )
    emit("select", selected)
    is_open.value = false
}
```

## Keyboard Navigation

```typescript
// Setup keyboard handlers
const handleKeydown = (event: KeyboardEvent) => {
    switch (event.key) {
        case "Escape":
            if (current_view.value === "image_detail") {
                closeDetailView()
            } else if (move_dialog.value.is_open) {
                closeMoveDialog()
            } else {
                is_open.value = false
            }
            break

        case "ArrowLeft":
            if (current_view.value === "image_detail") {
                navigateImage(-1)
            }
            break

        case "ArrowRight":
            if (current_view.value === "image_detail") {
                navigateImage(1)
            }
            break

        case "+":
        case "=":
            if (current_view.value === "image_detail") {
                detail_zoom_level.value = Math.min(3, detail_zoom_level.value + 0.25)
            }
            break

        case "-":
            if (current_view.value === "image_detail") {
                detail_zoom_level.value = Math.max(0.5, detail_zoom_level.value - 0.25)
            }
            break
    }
}

// Navigate between images in detail view
const navigateImage = (direction: 1 | -1) => {
    if (!detail_image.value) return

    const current_index = current_folder_images.value.findIndex(
        img => img.id === detail_image.value?.id
    )
    const new_index = current_index + direction

    if (new_index >= 0 && new_index < current_folder_images.value.length) {
        detail_image.value = current_folder_images.value[new_index]
        detail_zoom_level.value = 1
    }
}
```

## Lifecycle

