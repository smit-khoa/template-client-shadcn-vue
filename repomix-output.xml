                <slot name="footer">
                    <div class="flex items-center gap-2 w-full">
                        <Button variant="secondary" class="w-full" @click="cancelConfirm">Hủy</Button>
                        <Button variant="primary" class="w-full" :loading="loading" @click="handleConfirm"
                            >Xác nhận</Button
                        >
                    </div>
                </slot>
            </AlertDialogFooter>
        </AlertDialogContent>
    </AlertDialog>
