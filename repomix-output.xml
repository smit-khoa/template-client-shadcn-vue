const pivotProcessedData = computed(() => {
    if (!props.pivotMode) {
        return [] // Không áp dụng nếu không ở pivot mode
    }

    // Lọc ra các hàng con của các nhóm bị đóng
    return props.data.filter(row => {
        if (row.level === 0) {
            return true // Luôn hiển thị cấp cao nhất
