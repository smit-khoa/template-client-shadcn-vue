        <label
            class="switcher__option"
            v-for="(item, index) in tabs"
            :key="item.key"
            :ref="el => setItemRef(el, index)">
            <input
                class="switcher__input"
                type="radio"
                name="tabs"
                :value="item.key"
                v-model="selected"
                @change="changeTab"
                :c-option="index + 1" />
