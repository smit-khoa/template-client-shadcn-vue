# Phase 1: Component Structure & Types

## Overview
Định nghĩa cấu trúc component và các TypeScript interfaces cho ImageGalleryPopup.

## File Location
`src/components/app/chat/middle/ImageGalleryPopup.vue`

## TypeScript Interfaces

```typescript
// Folder structure
interface GalleryFolder {
    id: string
    name: string
    image_count: number
    is_editable: boolean  // false cho "Tải lên gần đây"
    created_at: string
}

// Image structure
interface GalleryImage {
    id: string
    folder_id: string
    url: string
    thumbnail_url: string
    name: string
    size: number
    width: number
    height: number
    created_at: string
}

// Component state enum
type GalleryViewState =
    | "folder_list"      // Default view với folders + images
    | "empty_folder"     // Folder không có ảnh
    | "search_empty"     // Search không có kết quả
    | "image_detail"     // Full screen xem ảnh

// Image action types
type ImageAction = "save" | "zoom" | "expand" | "delete" | "move"

// Move dialog state
interface MoveDialogState {
    is_open: boolean
    image_ids: string[]
    target_folder_id: string | null
}

// Delete dialog state
interface DeleteDialogState {
    is_open: boolean
    image_ids: string[]
}
```

## Component Props

```typescript
interface ImageGalleryPopupProps {
    modelValue: boolean           // v-model for open/close
    initialFolderId?: string      // Folder to open initially
    maxSelection?: number         // Max images to select (default: unlimited)
}
```

## Component Emits

```typescript
interface ImageGalleryPopupEmits {
    (e: "update:modelValue", value: boolean): void
    (e: "select", images: GalleryImage[]): void
    (e: "add-images", files: File[]): void
}
```

## Reactive State Structure

```typescript
// Core state
const is_open = computed({...})              // Popup visibility
const current_view = ref<GalleryViewState>("folder_list")
const folders = ref<GalleryFolder[]>([])
const images = ref<GalleryImage[]>([])

// Selection state
const selected_folder_id = ref<string | null>(null)
const selected_image_ids = ref<Set<string>>(new Set())

// Search state
const folder_search = ref("")
const filtered_folders = computed(() => {...})

// Hover states
const hovered_image_id = ref<string | null>(null)
const is_editing_image_name = ref(false)
const editing_image_id = ref<string | null>(null)

// Image detail view state
const detail_image = ref<GalleryImage | null>(null)
const detail_zoom_level = ref(1)

// Dialog states
const move_dialog = ref<MoveDialogState>({...})
const delete_dialog = ref<DeleteDialogState>({...})
```

## Computed Properties

```typescript
// Current folder's images
const current_folder_images = computed(() =>
    images.value.filter(img => img.folder_id === selected_folder_id.value)
)

// Selected images count
const selected_count = computed(() => selected_image_ids.value.size)

// Can perform actions
const can_move = computed(() => selected_count.value > 0 && folders.value.length > 1)
const can_delete = computed(() => selected_count.value > 0)

// Is folder empty
const is_folder_empty = computed(() => current_folder_images.value.length === 0)

// Search has no results
const search_no_results = computed(() =>
    folder_search.value.length > 0 && filtered_folders.value.length === 0
)
