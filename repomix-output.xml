                class="mock-switch-root"
                :class="modelValue ? 'checked' : 'unchecked'"
                :data-disabled="disabled"
                @click="!disabled && $emit('update:modelValue', !modelValue)"
            >
                <slot />
            </div>
        `,
        emits: ["update:modelValue"]
    },
    SwitchThumb: {
        name: "SwitchThumb",
