                    hover-color="#F93939"
                    class="cursor-pointer"
                    @click="removeTag(tag.categoryKey, tag.value)" />
            </div>
        </div>

        <!-- Clear all link -->
        <button
            class="text-sm font-medium text-[#7d91a6] hover:text-red-500 cursor-pointer transition-colors"
            @click="clearAll">
            Bỏ tất cả
