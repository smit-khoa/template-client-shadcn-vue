  //   spriteDiv.style.display = "none";
  //   spriteDiv.style.position = "absolute";
  //   spriteDiv.style.width = "0";
  //   spriteDiv.style.height = "0";

  //   // Minimal fallback sprites
  //   spriteDiv.innerHTML = `
