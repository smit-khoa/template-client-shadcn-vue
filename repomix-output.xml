```typescript
// src/api/gallery.ts

export interface GalleryApi {
    getFolders(): Promise<GalleryFolder[]>
    getImages(folder_id: string): Promise<GalleryImage[]>
    createFolder(name: string): Promise<GalleryFolder>
    renameFolder(id: string, name: string): Promise<void>
    deleteFolder(id: string): Promise<void>
    uploadImages(folder_id: string, files: File[]): Promise<GalleryImage[]>
    moveImages(image_ids: string[], target_folder_id: string): Promise<void>
    deleteImages(image_ids: string[]): Promise<void>
    renameImage(id: string, name: string): Promise<void>
}

// Implementation
export const galleryApi: GalleryApi = {
    async getFolders() {
        const response = await axios.get("/api/gallery/folders")
        return response.data
    },

    async getImages(folder_id: string) {
        const response = await axios.get(`/api/gallery/folders/${folder_id}/images`)
        return response.data
    },

    async createFolder(name: string) {
        const response = await axios.post("/api/gallery/folders", { name })
        return response.data
    },

    async uploadImages(folder_id: string, files: File[]) {
        const formData = new FormData()
        files.forEach(file => formData.append("images", file))

        const response = await axios.post(
            `/api/gallery/folders/${folder_id}/images`,
            formData,
            { headers: { "Content-Type": "multipart/form-data" } }
        )
        return response.data
    },

    async moveImages(image_ids: string[], target_folder_id: string) {
        await axios.patch("/api/gallery/images/move", {
            image_ids,
            target_folder_id
        })
    },

    async deleteImages(image_ids: string[]) {
        await axios.delete("/api/gallery/images", {
            data: { image_ids }
        })
    },

    // ... other methods
}
```

### 3. Store Integration (Optional)

```typescript
// src/stores/gallery.ts

import { defineStore } from "pinia"
import { galleryApi } from "@/api/gallery"

export const useGalleryStore = defineStore("gallery", {
    state: () => ({
        folders: [] as GalleryFolder[],
        images: [] as GalleryImage[],
        loading: false,
        error: null as string | null
    }),

    getters: {
        getFolderImages: (state) => (folder_id: string) => {
            return state.images.filter(img => img.folder_id === folder_id)
        },

        getDefaultFolder: (state) => {
            return state.folders.find(f => !f.is_editable) || state.folders[0]
        }
    },

    actions: {
        async fetchFolders() {
            this.loading = true
            try {
                this.folders = await galleryApi.getFolders()
            } catch (e) {
                this.error = "Failed to load folders"
            } finally {
                this.loading = false
            }
        },

        async fetchImages(folder_id: string) {
            this.loading = true
            try {
                const new_images = await galleryApi.getImages(folder_id)
                // Merge with existing
                new_images.forEach(img => {
                    const existing = this.images.findIndex(i => i.id === img.id)
                    if (existing === -1) {
                        this.images.push(img)
                    }
                })
            } finally {
                this.loading = false
            }
        },

        // ... other actions
    }
})
```

